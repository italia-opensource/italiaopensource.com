---
import { getCollection } from "astro:content";
import { DetailLayout } from "@walle/layouts";
import { Badge, Button } from "@walle/components";
import { resolveInternalUrl } from "@walle/utils";
import { SECTIONS, SECTION_LIST, badgeOf, primaryLinkOf, type SectionKey } from "../../utils/awesome";

export async function getStaticPaths() {
  const perSection = await Promise.all(
    SECTION_LIST.map(async (section) => {
      const entries = await getCollection(section.collection);
      return entries.map((entry) => ({
        params: { section: section.key, id: entry.id },
        props: { sectionKey: section.key, data: entry.data as Record<string, any> },
      }));
    })
  );
  return perSection.flat();
}

interface Props {
  sectionKey: SectionKey;
  data: Record<string, any>;
}
const { sectionKey, data } = Astro.props;
const section = SECTIONS[sectionKey];

const analytics = data.autogenerated?.analytics ?? {};
const meta = data.autogenerated?.meta ?? {};

// Section-specific fact rows (label → value). Empty values are filtered out.
function rows(): [string, string][] {
  const list: [string, string | undefined][] = [];
  if (sectionKey === "opensource") {
    list.push(["License", data.license]);
    list.push(["Language", analytics.language]);
    list.push(["Stars", analytics.stargazers_count?.toString()]);
    list.push(["Forks", analytics.forks_count?.toString()]);
    list.push(["Owner", meta.owner]);
  } else if (sectionKey === "communities") {
    list.push(["Platform", data.platform]);
    list.push(["Type", data.type]);
    list.push(["Events", (data.events_type ?? []).join(", ")]);
  }
  return list.filter(([, v]) => v != null && v !== "") as [string, string][];
}

const factRows = rows();
const tags: string[] = (data.tags ?? []).filter(Boolean);
const primary = primaryLinkOf(sectionKey, data);

const breadcrumbs = [
  { label: "Home", href: resolveInternalUrl("/") },
  { label: section.label, href: resolveInternalUrl(`/${section.key}`) },
  { label: data.name },
];
const badge = badgeOf(sectionKey, data);
---

<DetailLayout
  title={data.name}
  description={data.description}
  breadcrumbs={breadcrumbs}
  backLink={{ href: resolveInternalUrl(`/${section.key}`), label: `Back to ${section.label}` }}
>
  {badge && <Badge slot="badges" text={badge} variant="primary" />}

  <p class="lead">{data.description}</p>

  {
    factRows.length > 0 && (
      <dl class="facts">
        {factRows.map(([label, value]) => (
          <div class="facts__row">
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    )
  }

  <div slot="aside" class="aside">
    {
      primary && primary.href && (
        <Button text={primary.label} href={primary.href} variant="primary" target="_blank" />
      )
    }
    {
      tags.length > 0 && (
        <div class="tags">
          {tags.map((t) => (
            <span class="tag">#{t}</span>
          ))}
        </div>
      )
    }
  </div>
</DetailLayout>

<style>
  .lead {
    font-size: 1.15rem;
    line-height: 1.6;
  }
  .facts {
    margin: var(--space-xl) 0;
    border-top: 1px solid var(--border);
  }
  .facts__row {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--space-md);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--border);
  }
  .facts__row dt {
    font-weight: 700;
    color: var(--text);
  }
  .facts__row dd {
    margin: 0;
  }
  .resources ul {
    padding-left: 1.2rem;
    word-break: break-word;
  }
  .aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .tag {
    font-size: 0.8rem;
    background: var(--surface-alt);
    color: var(--primary);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }
  @media (max-width: 600px) {
    .facts__row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
